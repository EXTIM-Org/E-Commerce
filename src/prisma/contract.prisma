// use prisma-8

enum Role {
  USER
  BLOG_ADMIN
  ADMIN
  SUPER_ADMIN
  SUPPORT
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum TransactionType {
  RESTOCK
  SALE
  RETURN
  ADJUSTMENT
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model User {
  id            String    @id @default(uuid())
  name          String?
  image         String?
  email         String?   @unique
  phoneNumber   String?   @unique
  phoneVerified Boolean   @default(false)
  passwordHash  String?
  otpCode       String?
  otpExpiry     TimestamptzString?
  role          Role      @default(USER)
  resetToken       String?   @unique
  resetTokenExpiry TimestamptzString?
  createdAt     TimestamptzString @default(now())
  updatedAt     temporal.updatedAtString()
  
  isBanned      Boolean   @default(false)
  banReason     String?
  adminNotes    String?
  
  addresses     Address[]
  orders        Order[]
  cart          Cart?
  reviews       Review[]
  reviewVotes   ReviewVote[]
  wishlist      Wishlist?
  questions     Question[]
  answers       Answer[]
  articles      Article[]
  tickets       Ticket[]
  ticketMessages TicketMessage[]
  returnRequests ReturnRequest[]
}

model Address {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String?   // e.g., Home, Work
  city          String?
  province      String?
  postalCode    String?
  fullAddress   String
  isDefault     Boolean   @default(false)
  createdAt     TimestamptzString @default(now())
}

model Category {
  id            String    @id @default(uuid())
  name          String
  slug          String    @unique
  parentId      String?
  parent        Category? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  subcategories Category[] @relation("CategoryHierarchy")
  
  iconName      String?   // Lucide icon name, e.g. "Smartphone"
  colorGradient String?   // Tailwind gradient, e.g. "from-pink-500 to-rose-500"
  image         String?   // Custom uploaded image/icon URL
  
  products      Product[]
  createdAt     TimestamptzString @default(now())
  updatedAt     temporal.updatedAtString()
}

model Product {
  id            String    @id @default(uuid())
  name          String
  slug          String    @unique
  description   String?
  categoryId    String
  category      Category  @relation(fields: [categoryId], references: [id])
  tickets       Ticket[]
  
  basePrice     Float     // The base/display price of the product
  discount      Float     @default(0) // Discount percentage or amount
  images        String[]  // Array of image URLs
  
  variants      ProductVariant[]
  specifications ProductSpecification[]
  reviews       Review[]
  wishlistItems WishlistItem[]
  questions     Question[]
  flashSale     FlashSale?
  
  viewCount     Int       @default(0) // Track product views
  salesCount    Int       @default(0) // Track product sales
  
  createdAt     TimestamptzString @default(now())
  updatedAt     temporal.updatedAtString()
}

model FlashSale {
  id              String    @id @default(uuid())
  productId       String    @unique
  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  discountPercent Int
  startTime       TimestamptzString
  endTime         TimestamptzString
  isActive        Boolean   @default(true)
  
  createdAt       TimestamptzString @default(now())
  updatedAt       temporal.updatedAtString()
}

model Wishlist {
  id        String    @id @default(uuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]
  createdAt TimestamptzString @default(now())
}

model WishlistItem {
  id          String    @id @default(uuid())
  wishlistId  String
  wishlist    Wishlist  @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt   TimestamptzString @default(now())
  
  @@unique([wishlistId, productId])
}

model ProductVariant {
  id            String    @id @default(uuid())
  productId     String
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  name          String?   // e.g., "Red - Large" or "Default" if no variants
  sku           String    @unique
  price         Float?    // If different from base price
  
  inventory     Inventory?
  cartItems     CartItem[]
  orderItems    OrderItem[]
}

model Inventory {
  id                String    @id @default(uuid())
  variantId         String    @unique
  variant           ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  
  stockQuantity     Int       @default(0) // Available for sale
  reservedStock     Int       @default(0) // In users' carts currently
  lowStockThreshold Int       @default(5)
  
  transactions      InventoryTransaction[]
  
  updatedAt         temporal.updatedAtString()
}

model InventoryTransaction {
  id            String    @id @default(uuid())
  inventoryId   String
  inventory     Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  
  type          TransactionType
  quantity      Int       // Positive for RESTOCK/RETURN, Negative for SALE
  reference     String?   // Order ID or reason for adjustment
  
  createdAt     TimestamptzString @default(now())
}

model Cart {
  id            String    @id @default(uuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  items         CartItem[]
  
  createdAt     TimestamptzString @default(now())
  updatedAt     temporal.updatedAtString()
}

model CartItem {
  id            String    @id @default(uuid())
  cartId        String
  cart          Cart      @relation(fields: [cartId], references: [id], onDelete: Cascade)
  
  variantId     String
  variant       ProductVariant @relation(fields: [variantId], references: [id])
  
  quantity      Int
  reservedAt    TimestamptzString? // Timestamp for the 15-min reservation release logic
}

model Order {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  
  status        OrderStatus @default(PENDING)
  tickets       Ticket[]
  totalAmount   Float
  
  couponId      String?
  coupon        Coupon?   @relation(fields: [couponId], references: [id])
  discountAmount Float    @default(0)
  
  // Payment gateway snapshot
  paymentAuthority String?
  paymentRefId     String?
  
  // Shipping snapshot
  receiverName    String
  phone           String
  shippingAddress String
  postalCode      String?
  trackingCode    String?
  
  items         OrderItem[]
  
  createdAt     TimestamptzString @default(now())
  updatedAt     temporal.updatedAtString()
}

model OrderItem {
  id            String    @id @default(uuid())
  orderId       String
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  variantId     String
  variant       ProductVariant @relation(fields: [variantId], references: [id])
  
  quantity      Int
  unitPrice     Float     // Snapshot of price at the time of purchase
  
  returnRequest ReturnRequest?
}

model Review {
  id            String    @id @default(uuid())
  productId     String
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  rating        Int       // 1 to 5
  comment       String?
  
  isVerifiedBuyer Boolean   @default(false)
  purchasedVariantName String?
  
  adminReply    String?
  adminReplyAt  TimestamptzString?
  
  votes         ReviewVote[]
  
  createdAt     TimestamptzString @default(now())
}

model Coupon {
  id            String    @id @default(uuid())
  code          String    @unique
  type          DiscountType
  value         Float
  maxDiscount   Float?
  minOrderAmount Float?
  usageLimit    Int?
  usedCount     Int       @default(0)
  expiresAt     TimestamptzString?
  isActive      Boolean   @default(true)
  
  orders        Order[]
  
  createdAt     TimestamptzString @default(now())
  updatedAt     temporal.updatedAtString()
}

model Question {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  text      String
  
  answers   Answer[]
  createdAt TimestamptzString @default(now())
}

model Answer {
  id         String   @id @default(uuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  text       String
  isAdmin    Boolean  @default(false)
  
  createdAt  TimestamptzString @default(now())
}

model ReviewVote {
  id        String   @id @default(uuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  isLike    Boolean  // true for like, false for dislike
  createdAt TimestamptzString @default(now())

  @@unique([reviewId, userId])
}

model ProductSpecification {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  name      String
  value     String
  
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
  
  @@unique([productId, name])
}

model ArticleCategory {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  
  articles    Article[]
  
  createdAt   TimestamptzString  @default(now())
  updatedAt   temporal.updatedAtString()
}

model Article {
  id          String    @id @default(uuid())
  title       String
  slug        String    @unique
  excerpt     String?
  content     String
  coverImage  String?
  
  status      ArticleStatus @default(DRAFT)
  viewCount   Int       @default(0)
  
  categoryId  String
  category    ArticleCategory @relation(fields: [categoryId], references: [id])
  
  authorId    String
  author      User      @relation(fields: [authorId], references: [id])
  
  publishedAt TimestamptzString?
  createdAt   TimestamptzString  @default(now())
  updatedAt   temporal.updatedAtString()
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
}

enum TicketStatus {
  OPEN
  SEEN
  IN_PROGRESS
  WAITING_FOR_USER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketDepartment {
  SALES
  SUPPORT
  TECHNICAL
}

model Ticket {
  id          String   @id @default(uuid())
  subject     String
  status      TicketStatus @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  department  TicketDepartment @default(SUPPORT)
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  orderId     String?
  order       Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  
  messages    TicketMessage[]
  
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()
}

model TicketMessage {
  id          String   @id @default(uuid())
  ticketId    String
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  text        String
  attachments String[] @default([])
  isInternal  Boolean  @default(false)
  
  createdAt   TimestamptzString @default(now())
}

enum ReturnStatus {
  SUBMITTED
  PENDING
  APPROVED
  REJECTED
  REFUNDED
}

model ReturnRequest {
  id          String   @id @default(uuid())
  orderItemId String   @unique
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  reason      String
  description String?
  images      String[] @default([])
  status      ReturnStatus @default(SUBMITTED)
  adminNote   String?
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()
}
