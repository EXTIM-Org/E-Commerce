{
  "name": "extim-e-commerce",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"next dev\" \"npm run worker\"",
    "dev:clean": "node -e \"require('fs').rmSync('.next', {recursive:true, force:true})\" && npm run dev",
    "worker": "tsx src/worker-server.ts",
    "build": "node -e \"require('fs').rmSync('.next', {recursive:true, force:true})\" && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma skills sync || exit 0",
    "contract:emit": "prisma contract emit"
  },
  "dependencies": {
    "@prisma/client": "^7.10.0",
    "@prisma/orm-postgres": "^8.0.0-rc.11",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@sentry/nextjs": "^10.75.2",
    "@tailwindcss/typography": "^0.5.20",
    "@types/pg": "^8.23.1",
    "adm-zip": "^0.6.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.8",
    "dotenv": "^18.0.1",
    "exceljs": "^4.4.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hot-toast": "^2.6.1",
    "react-markdown": "^10.1.0",
    "react-multi-date-picker": "^4.5.2",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@prisma/cli-engine": "^0.4.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sharp": "^0.31.1",
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prisma": "^8.0.0-rc.15",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
